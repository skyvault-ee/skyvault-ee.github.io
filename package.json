{
  "name": "skyvault-web",
  "private": true,
  "scripts": {
    "build": "sh scripts/build-site.sh",
    "build:css": "tailwindcss -i ./assets/css/source.css -o ./assets/css/site.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/source.css -o ./assets/css/site.css --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
